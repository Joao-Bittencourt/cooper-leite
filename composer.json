{
    "name": "joao_bittencourt/cooper_leite",
    "type": "library",
    "require": {
        "php": ">=7.4",
        "illuminate/database": "^8.83",
        "open-telemetry/sdk": "^1.14",
        "open-telemetry/exporter-otlp": "^1.4",
        "open-telemetry/opentelemetry-auto-pdo": "^0.0.15",
        "nyholm/psr7": "^1.8",
        "php-http/guzzle7-adapter": "^1.1"
    },
    "require-dev": {
        "phpunit/phpunit": "~8.5.0 || ^9.3",
        "infection/infection": "^0.27.11"
    },
    "config": {
        "audit": {
            "block-insecure": false
        },
        "allow-plugins": {
            "infection/extension-installer": true,
            "php-http/discovery": true,
            "tbachert/spi": true
        }
    },
    "autoload": {
        "psr-4": {
            "core\\": "src/core/",
            "CooperLeite\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CooperLeite\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit -c phpunit.xml.dist --stderr",
        "test-coverage": "vendor/bin/phpunit -c phpunit.xml.dist --stderr --coverage-html coverage-report",
        "infection": "vendor/bin/infection",
        "test-all": [
            "@test",
            "@infection"
        ]
    }
}
